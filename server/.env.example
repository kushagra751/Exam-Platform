PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/exam-platform
# Use a long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-strong-secret
CLIENT_URL=http://localhost:5173
# Required to register accounts with the admin role. Leave empty to disable admin self-registration.
ADMIN_SIGNUP_CODE=replace-with-a-private-admin-code

# Optional: Current Affairs generator
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
NEWS_API_KEY=
GNEWS_API_KEY=
CURRENTS_API_KEY=
